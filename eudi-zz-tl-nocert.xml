<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!-- Synthetic ZZ trusted list used by autotest to exercise the skipped-without-cert warning path.
     TSP 1 has a valid X509Certificate and is imported (1 issuer entity).
     TSP 2 has only an X509SubjectName (no X509Certificate) and must be skipped, triggering
     the etsiTlSkippedIssuersWithoutCert warning in updateTrustedIssuers.
     There is intentionally no <Signature> block — the test creates the registry without signing_certs,
     so signature verification is skipped (soft check). -->
