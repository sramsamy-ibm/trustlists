                    <ServiceInformation>
                        <ServiceTypeIdentifier>http://uri.etsi.org/19602/SvcType/PID/Issuance</ServiceTypeIdentifier>
                        <ServiceName><Name xml:lang="en">ZZ No-Cert PID Issuance (skipped)</Name></ServiceName>
                        <ServiceDigitalIdentity><DigitalId><X509SubjectName>CN=ZZ No-Cert PID Issuance, C=ZZ</X509SubjectName></DigitalId></ServiceDigitalIdentity>
                        <ServiceStatus>http://uri.etsi.org/TrstSvc/TrustedList/Svcstatus/granted</ServiceStatus>
