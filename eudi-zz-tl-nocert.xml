        </SchemeInformationURI>
        <StatusDeterminationApproach>http://uri.etsi.org/TrstSvc/TrustedList/StatusDetn/EUappropriate</StatusDeterminationApproach>
        <SchemeTypeCommunityRules>
            <URI xml:lang="en">http://uri.etsi.org/TrstSvc/TrustedList/schemerules/EUcommon</URI>
            <URI xml:lang="en">http://uri.etsi.org/TrstSvc/TrustedList/schemerules/ZZ</URI>
        </SchemeTypeCommunityRules>
        <SchemeTerritory>ZZ</SchemeTerritory>
        <PolicyOrLegalNotice>
            <TSLLegalNotice xml:lang="en">Synthetic test trusted list for ZZ territory. Not a real trusted list.</TSLLegalNotice>
        </PolicyOrLegalNotice>
        <HistoricalInformationPeriod>65535</HistoricalInformationPeriod>
        <ListIssueDateTime>2025-01-01T00:00:00Z</ListIssueDateTime>
        <NextUpdate>
            <dateTime>2055-01-01T00:00:00Z</dateTime>
        </NextUpdate>
    </SchemeInformation>
    <TrustServiceProviderList>
        <!-- TSP 1: valid cert — produces 1 issuer entity (eu.europa.ec.eudi.pid.1 + urn:eudi:pid:1 = 2 rows via default docTypes) -->
        <TrustServiceProvider>
            <TSPInformation>
                <TSPName><Name xml:lang="en">ZZ Valid TSP</Name></TSPName>
                <TSPAddress>
                    <PostalAddresses>
                        <PostalAddress xml:lang="en">
                            <StreetAddress>1 ZZ Valid Road</StreetAddress>
                            <Locality>ZZ Test City</Locality>
